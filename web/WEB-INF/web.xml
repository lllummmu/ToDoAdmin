<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- 1. 欢迎页：打开项目直接跳登录 -->
    <welcome-file-list>
        <welcome-file>login.html</welcome-file>
    </welcome-file-list>

    <!-- 2. 登录 -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.todoapp.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- 3. 注册 -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.todoapp.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- 4. 任务 -->
    <servlet>
        <servlet-name>TaskServlet</servlet-name>
        <servlet-class>com.todoapp.controller.TaskServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TaskServlet</servlet-name>
        <url-pattern>/tasks</url-pattern>
        <url-pattern>/tasks/*</url-pattern>
    </servlet-mapping>

    <!-- 5. 用户列表（下拉框用） -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>com.todoapp.controller.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/users</url-pattern>
    </servlet-mapping>

    <!-- ===== 工程化前端 REST API（/api/*，JSON 响应，兼容旧页面） ===== -->

    <servlet>
        <servlet-name>ApiAuthServlet</servlet-name>
        <servlet-class>com.todoapp.controller.api.ApiAuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiAuthServlet</servlet-name>
        <url-pattern>/api/login</url-pattern>
        <url-pattern>/api/register</url-pattern>
        <url-pattern>/api/logout</url-pattern>
        <url-pattern>/api/me</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiTaskServlet</servlet-name>
        <servlet-class>com.todoapp.controller.api.ApiTaskServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiTaskServlet</servlet-name>
        <url-pattern>/api/tasks</url-pattern>
        <url-pattern>/api/tasks/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiUserServlet</servlet-name>
        <servlet-class>com.todoapp.controller.api.ApiUserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiUserServlet</servlet-name>
        <url-pattern>/api/users</url-pattern>
    </servlet-mapping>

    <!-- 文件上传（multipart，10MB 上限） -->
    <servlet>
        <servlet-name>UploadServlet</servlet-name>
        <servlet-class>com.todoapp.controller.api.UploadServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>10485760</max-request-size>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>UploadServlet</servlet-name>
        <url-pattern>/api/upload</url-pattern>
    </servlet-mapping>

    <!-- SSE 实时推送（异步） -->
    <servlet>
        <servlet-name>SseServlet</servlet-name>
        <servlet-class>com.todoapp.controller.api.SseServlet</servlet-class>
        <async-supported>true</async-supported>
    </servlet>
    <servlet-mapping>
        <servlet-name>SseServlet</servlet-name>
        <url-pattern>/api/events</url-pattern>
    </servlet-mapping>

</web-app>